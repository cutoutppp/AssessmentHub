rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. กฎพิเศษสำหรับ "รายชื่อนักเรียน" (TradeSimSchool)
    match /student_list/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. แบบประเมินการใช้เครื่องมือวัดผล (AssessmentHub / NextSGS) - เปิดรับข้อมูล
    match /assessment_tool_surveys/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // 3. การตั้งค่าข้อคำถามแบบประเมินและอาคารสอบ (Real-time Survey Config)
    match /survey_config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 4. ระบบ Asset Allocation การจัดสรรสินทรัพย์ในห้องเรียน (Real-time Classroom Sync)
    match /asset_allocation_teams/{teamId} {
      allow read, write: if true;
    }
    match /asset_allocation_state/{docId} {
      allow read, write: if true;
    }

    // 5. กฎความปลอดภัยทั่วไป
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
